# Copy this file to webapp/.env and supply your own rotated credentials.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://root:@localhost:3306/somali_misinfo
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_EMAIL=

# Primary administrator. Existing installations keep the current password;
# PRIMARY_ADMIN_PASSWORD is only used when the primary account does not exist.
PRIMARY_ADMIN_EMAIL=admin@somali.com
PRIMARY_ADMIN_USERNAME=Hussein
PRIMARY_ADMIN_PASSWORD=

# Evidence retrieval providers. The app still has non-key fallbacks, but configuring
# at least one LLM and one search API improves claim extraction and coverage.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Somali audio/video transcription
HF_TOKEN=
ASR_CACHE_DIR=
ASR_MODEL_ID=IbrahimDayax/xls-r-1b-somali-stt-asr
# auto: RunPod when configured, otherwise local CPU development fallback
# remote: require RunPod; local: always use the local CPU model
ASR_BACKEND=remote
RUNPOD_API_KEY=
RUNPOD_ASR_ENDPOINT_ID=y9l1nkt4sad3p6
TRANSCRIPT_CLAIM_EXTRACTION_MIN_WORDS=180
RUNPOD_ASR_WAIT_MS=300000
RUNPOD_ASR_REQUEST_TIMEOUT_SECONDS=330
RUNPOD_ASR_MAX_PAYLOAD_MB=13
ASR_MAX_UPLOAD_MB=500
ASR_MAX_DURATION_SECONDS=3600
ASR_CHUNK_SECONDS=28
ASR_OVERLAP_SECONDS=1
ASR_CPU_THREADS=0
ASR_RESULT_CACHE_ENABLED=true
ASR_URL_CACHE_TTL_SECONDS=604800
MEDIA_URL_SOCKET_TIMEOUT_SECONDS=30
YTDLP_DENO_PATH=
YTDLP_COOKIE_FILE=
# Keep disabled in production. Uploaded WAV, MP3, M4A, and MP4 are supported.
ENABLE_PUBLIC_MEDIA_LINKS=false
EXA_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
APIFY_TOKEN=
YOUTUBE_API_KEY=
FETCH_SOURCE_DATES=false
